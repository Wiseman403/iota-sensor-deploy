{
  "name": "IOTA Move Deploy",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "bash .devcontainer/install-iota.sh",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "iotaledger.iota-move",
        "ms-vscode.vscode-json"
      ]
    }
  }
}
